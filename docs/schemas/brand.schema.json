          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "regex character class, e.g. A-Z0-9_-",
          "title": "Allowed"
        },
        "replace": {
          "additionalProperties": {
            "type": "string"
          },
          "title": "Replace",
          "type": "object"
        },
        "strip_whitespace": {
          "default": true,
          "title": "Strip Whitespace",
          "type": "boolean"
        },
        "trim": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "characters stripped from both ends",
          "title": "Trim"
        },
        "upper": {
          "default": true,
          "title": "Upper",
          "type": "boolean"
        }
      },
      "title": "MpnNormalisation",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
