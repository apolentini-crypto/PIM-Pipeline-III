          "type": "string"
        },
        "token_env": {
          "description": "name of the env var holding the API token (never the value)",
          "title": "Token Env",
          "type": "string"
        }
      },
      "required": [
        "kind",
        "store_hash_env",
        "token_env"
      ],
      "title": "Environment",
      "type": "object"
    },
    "MpnNormalisation": {
